{
  "name": "cypress-mcp",
  "version": "0.2.0",
  "description": "MCP server for AI-driven Cypress test execution. Run, debug, and iterate on E2E tests from your AI agent, with Cypress Cloud recording and flaky test detection.",
  "type": "module",
  "bin": {
    "cypress-mcp": "./bin/cypress-mcp.mjs"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "bin",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "lint": "eslint src/ test/",
    "lint:fix": "eslint src/ test/ --fix",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "cypress",
    "mcp",
    "model-context-protocol",
    "testing",
    "e2e",
    "ai-tools",
    "test-automation",
    "claude",
    "cursor",
    "cypress-cloud",
    "flaky-tests"
  ],
  "author": "JADEV GROUP SARL <info@jadev-group.com> (https://jadev-group.com)",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jams4code/cypress-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/jams4code/cypress-mcp/issues"
  },
  "homepage": "https://github.com/jams4code/cypress-mcp#readme",
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "tinyglobby": "^0.2.17",
    "tree-kill": "^1.2.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "eslint": "^9.39.5",
    "prettier": "^3.9.10",
    "tsup": "^8.5.0",
    "typescript": "^5.8.0",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "cypress": ">=12.0.0"
  },
  "peerDependenciesMeta": {
    "cypress": {
      "optional": true
    }
  }
}
